{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        {
          "slug": "forest",
          "color": "#1F3D2B",
          "name": "Verde bosque"
        },
        {
          "slug": "forest-soft",
          "color": "#2F5A40",
          "name": "Verde bosque suave"
        },
        {
          "slug": "forest-deep",
          "color": "#142A1D",
          "name": "Verde profundo"
        },
        {
          "slug": "cream",
          "color": "#F7F3E8",
          "name": "Crema"
        },
        {
          "slug": "cream-dark",
          "color": "#EFE8D8",
          "name": "Crema oscura"
        },
        {
          "slug": "paper",
          "color": "#FBF8F0",
          "name": "Papel"
        },
        {
          "slug": "terracotta",
          "color": "#C4704F",
          "name": "Terracota"
        },
        {
          "slug": "sage",
          "color": "#8FA98F",
          "name": "Salvia"
        },
        {
          "slug": "sage-soft",
          "color": "#C5D3C3",
          "name": "Salvia suave"
        },
        {
          "slug": "charcoal",
          "color": "#222222",
          "name": "Carbón"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Fraunces\", Georgia, serif",
          "name": "Fraunces",
          "slug": "fraunces"
        },
        {
          "fontFamily": "\"Manrope\", system-ui, sans-serif",
          "name": "Manrope",
          "slug": "manrope"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "size": "0.875rem",
          "name": "Pequeño"
        },
        {
          "slug": "medium",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "large",
          "size": "1.25rem",
          "name": "Grande"
        },
        {
          "slug": "x-large",
          "size": "1.75rem",
          "name": "Muy grande"
        },
        {
          "slug": "display",
          "size": "clamp(2.1rem, 4.4vw, 4.1rem)",
          "name": "Display"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "XXS"
        },
        {
          "slug": "30",
          "size": "1rem",
          "name": "XS"
        },
        {
          "slug": "40",
          "size": "1.5rem",
          "name": "S"
        },
        {
          "slug": "50",
          "size": "2rem",
          "name": "M"
        },
        {
          "slug": "60",
          "size": "3rem",
          "name": "L"
        },
        {
          "slug": "70",
          "size": "4rem",
          "name": "XL"
        },
        {
          "slug": "80",
          "size": "6rem",
          "name": "XXL"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--charcoal)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--manrope)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--fraunces)",
          "fontWeight": "500",
          "lineHeight": "1.1"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "var(--wp--preset--color--forest)",
          "text": "var(--wp--preset--color--cream)"
        },
        "typography": {
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "999px"
        }
      },
      "core/heading": {
        "color": {
          "text": "var(--wp--preset--color--forest)"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--terracotta)",
            "style": "solid",
            "width": "2px"
          }
        }
      }
    }
  }
}
