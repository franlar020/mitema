{
  "name": "fauna-del-velazco",
  "version": "0.1.0",
  "private": true,
  "description": "Tema WordPress a medida para Fauna del Velazco",
  "scripts": {
    "dev:css": "tailwindcss -i ./assets/src/css/app.css -o ./assets/dist/app.css --watch",
    "dev:js": "esbuild ./assets/src/js/app.js --bundle --sourcemap --outfile=./assets/dist/app.js --watch",
    "build:css": "tailwindcss -i ./assets/src/css/app.css -o ./assets/dist/app.css --minify",
    "build:js": "esbuild ./assets/src/js/app.js --bundle --minify --outfile=./assets/dist/app.js",
    "build": "npm run build:css && npm run build:js",
    "docs": "node scripts/build-docx.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/cli": "^4.3.4",
    "docx": "^9.15.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.4"
  }
}
